{
  "name": "gf-poly-factor",
  "version": "1.0.0",
  "description": "素数有限域一元多项式分解与不可约证书后端（TypeScript + Node.js + SQLite）",
  "type": "commonjs",
  "main": "dist/cli/index.js",
  "bin": {
    "gfpoly": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/cli/index.js serve",
    "serve": "node dist/cli/index.js serve",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "demo": "node dist/cli/index.js demo",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
